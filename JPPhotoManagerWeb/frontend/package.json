{
  "name": "jp-photo-manager-ui",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "cypress run --component",
    "test:coverage": "cypress run --component --env coverage=true",
    "coverage:check": "nyc check-coverage",
    "test:e2e": "cypress run --e2e",
    "test:e2e:mocked": "start-server-and-test start http://localhost:4200 cy:e2e:mocked:run",
    "cy:e2e:mocked:run": "cypress run --e2e --config-file cypress.mocked.config.ts",
    "cypress:open": "cypress open --component",
    "cypress:e2e": "cypress open --e2e",
    "lint": "ng lint",
    "complexity": "node scripts/cyclomatic-complexity.js src/app",
    "complexity:report": "node scripts/complexity-report.js",
    "type-coverage:report": "node scripts/type-coverage-report.js",
    "dead-code:report": "node scripts/dead-code-report.js",
    "route-coverage:report": "node scripts/route-coverage-report.js",
    "lighthouse:report": "node scripts/lighthouse-report.mjs",
    "coverage:report": "node scripts/code-coverage-report.js",
    "bundle:report": "node scripts/bundle-size-report.js",
    "deps:staleness": "node scripts/dependency-staleness-report.js",
    "test:e2e:report": "node scripts/e2e-run-report.js --real",
    "test:e2e:mocked:report": "start-server-and-test start http://localhost:4200 cy:e2e:mocked:report",
    "cy:e2e:mocked:report": "node scripts/e2e-run-report.js --mocked"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/service-worker": "^22.1.1",
    "@swimlane/ngx-charts": "^24.0.0-alpha.1",
    "idb": "^8.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.1",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.1",
    "@babel/core": "^7.29.0",
    "@cypress/code-coverage": "^4.0.3",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^8.0.0",
    "chrome-launcher": "^1.2.1",
    "cypress": "^15.20.1",
    "eslint": "^9.39.4",
    "istanbul-lib-instrument": "^6.0.3",
    "knip": "^6.32.2",
    "lighthouse": "^13.4.1",
    "start-server-and-test": "^3.0.12",
    "type-coverage": "^2.30.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "zone.js": "^0.15.1"
  }
}
